# Postgres + pgvector (matches docker-compose.yml; host port 5433 avoids clashing with a local Postgres on 5432)
DATABASE_URL=postgres://hearthy:hearthy@localhost:5433/hearthy

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Context window passed to the chat model. 8192 fits an 8B Q4 model in 8 GB of VRAM.
NUM_CTX=8192

# Retrieval
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Only used by the integration tests (npm test). docker-compose creates this database for you.
# TEST_DATABASE_URL=postgres://hearthy:hearthy@localhost:5433/hearthy_test
